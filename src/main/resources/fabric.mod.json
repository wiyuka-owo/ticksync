{
  "schemaVersion": 1,
  "id": "ticksync",
  "version": "${version}",
  "name": "TickSync",
  "description": "Reduces packet and melee knockback latency, with optional phase diagnostics and a compact client HUD.",
  "authors": [
    "noryea"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.wiyuka.ticksync.TickSync"
    ],
    "client": [
      "com.wiyuka.ticksync.client.TickSyncClient"
    ]
  },
  "mixins": [
    "ticksync.mixins.json",
    {
      "config": "ticksync.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  }
}
